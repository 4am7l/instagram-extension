{
  "manifest_version": 3,
  "name": "Instagram Extension",
  "version": "0.4.0",
  "description": "Download Instagram videos and Direct voice messages, and copy captions.",
  "permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "media-url.js",
        "stream-download.js",
        "content.js",
        "voice-download.js"
      ]
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["voice-playback.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
