{
  "manifest_version": 3,
  "name": "Instagram Extension",
  "version": "0.3.0",
  "description": "Download videos from Instagram posts, Reels, and Stories.",
  "permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "media-url.js",
        "stream-download.js",
        "content.js"
      ]
    }
  ]
}
